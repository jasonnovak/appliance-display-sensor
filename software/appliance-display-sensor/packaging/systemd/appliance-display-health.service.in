[Unit]
Description=Passive Appliance Display Sensor health history
After=systemd-journald.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
ExecStart=/usr/bin/python3 /usr/local/lib/appliance-display-sensor/health-sample.py --interface @INTERFACE@
TimeoutStartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=appliance-display-health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
